{
  "version": 1,
  "note": "Field areas for every temple profile. Nothing here is pre-filled except values the dataset already holds (map: path). A value is only shown as filled when it has a source and a date.",
  "sources": {
    "official": "Official temple website, notice board or published order",
    "endowment": "State endowment board / devasthanam / trust records",
    "asi": "Archaeological Survey of India or state archaeology department",
    "osm": "OpenStreetMap tag",
    "osm_computed": "Computed from OpenStreetMap features near the temple (straight-line distance, mapped features only)",
    "wikidata": "Wikidata item",
    "wikipedia": "Wikipedia article",
    "published": "Book, journal, district gazetteer or inscription survey",
    "visit": "First-hand visit by a member, with the date"
  },
  "groups": [
