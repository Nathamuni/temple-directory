# Copy to .env.local for development. .env.local is gitignored.

# Signs the session cookie. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Built-in account passwords. Optional in development (the defaults in
# src/lib/users.ts are used), REQUIRED in production — the app refuses to
# start without them so the published defaults can never be live.
# ADMIN_PASSWORD=
# CONTRIBUTOR_PASSWORD=
# ADMIN_USERNAME=admin

# Where mutable data lives. Unset = <repo>/data, which is correct locally.
# On a hosted deploy point this at a persistent disk, e.g. /var/data.
# DATA_DIR=
