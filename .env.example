# Copy to .env (never commit .env). The app reads real environment variables; a hosting dashboard works the same way.
DATABASE_URL=postgres://postgres:temple@localhost:5440/temple_directory
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080

# Sign-in is name + email with NO verification for now. The variables below are only used if email verification is switched
# back on (the code is commented out in server/routes/auth.js).
# MAIL_API_KEY=
# MAIL_FROM=Global Temple Directory <onboarding@resend.dev>
# ADMIN_EMAILS=

# Dummy admin button on the sign-in page. Automatically on in development (DEV_LINKS=1, not production).
# In production it is OFF unless you set ALLOW_DEV_ADMIN=1, which lets ANY visitor become an admin. Use only on a private/demo site.
DEV_LINKS=1
ALLOW_DEV_ADMIN=

# Set to 1 if your Postgres requires SSL (most hosted databases reached over the public internet)
PGSSL=
LOG=
